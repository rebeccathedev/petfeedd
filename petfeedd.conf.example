[general]
discovery_enabled=1
database=petfeedd.db
name=Living Room Feeder

[web]
web_enabled=1
bind_address=127.0.0.1
bind_port=8080

[gpio]
servo_pin=17
sevo_feed_time=0.26

[email_notifications]
enabled=1
from=petfeedd
me@rebeccapeck.org
subject=Feed Event
me@rebeccapeck.org
server=example.com
port=25
me@rebeccapeck.org
password=password

[pushbullet_notifications]
enabled=1
subject=Feed Event
api_key=api.key

[twitter_notifications]
enabled=0
consumer_key=
consumer_secret=
access_key=
access_secret=
